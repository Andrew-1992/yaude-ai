SANADI_CHECKPOINT=checkpoints/sanadi-coder-v0

# Shared secret required in the X-API-Key header on /chat.
# Leave unset for local development. MUST be set before this server is
# reachable by anyone other than you.
SANADI_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to http://localhost:3000 if unset.
SANADI_ALLOWED_ORIGINS=http://localhost:3000

# Requests allowed per minute per API key (or per IP if no key set).
SANADI_RATE_LIMIT=10/minute

# Signing secret for account session tokens (JWT). REQUIRED for signup/
# login to work -- without it, /auth/* returns a clear error instead of
# issuing insecure tokens. Generate a random string, same approach as
# SANADI_API_KEY.
SANADI_JWT_SECRET=
